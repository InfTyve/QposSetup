<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 移植自 S25 service：禁止下拉状态栏（signature|privileged） -->
    <uses-permission
        android:name="android.permission.STATUS_BAR"
        tools:ignore="ProtectedPermissions" />

    <!-- TestMode 悬浮窗 -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:ignore="ProtectedPermissions" />

    <!-- 退出开机向导后重启设备 -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />

    <!-- 判断 com.android.setup 是否在前台 -->
    <uses-permission
        android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />

    <!-- 开机后恢复守护/悬浮窗/状态栏标志 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".service.ServiceSettings"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Setup">
        <activity
            android:name=".HomeSActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity2"
            android:exported="false" />

        <activity-alias
            android:name=".TopLevelSettingsActivity"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.android.setup.MainActivity2">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/app_name" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/summary_setup" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_icon_summ" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="122" />
        </activity-alias>

        <activity
            android:name=".TfeActivity"
            android:exported="false" />
        <activity
            android:name=".IconActivity"
            android:exported="false"
            android:theme="@style/Open.MigPreference" />
        <activity
            android:name=".TestSetup2Activity"
            android:exported="true" />
        <activity
            android:name=".TestSetupActivity"
            android:exported="true" />
        <activity
            android:name=".OverActivity"
            android:exported="false" />
        <activity
            android:name=".StartActivity"
            android:exported="false" />
        <!-- 语言选择页：MainActivity 的按钮进入，右下角按钮进入 StartActivity -->
        <activity
            android:name=".LauActivity"
            android:exported="false"
            android:theme="@style/Theme.Setup" />
        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.SETUP_WIZARD" />
            </intent-filter>
        </activity>

        <!-- 保留的 Compose 偏好页（XmlPreferenceActivity 仍在使用 overlays 配置页） -->
        <activity
            android:name=".compose.ui.preference.XmlPreferenceActivity"
            android:exported="true" />
    </application>

</manifest>