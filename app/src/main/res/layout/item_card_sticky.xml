<?xml version="1.0" encoding="utf-8"?>
<!-- 重要类卡片 - 红色警告样式 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_important_stroke"
    app:cardBackgroundColor="@color/card_important_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:tint="@color/card_important_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/card_important_title"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cardSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/card_important_summary"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cardDismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_card_close"
            android:contentDescription="关闭"
            android:visibility="gone"
            app:tint="@color/card_important_icon" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
