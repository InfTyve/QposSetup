<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TestSetupActivity">

    <Button
        android:id="@+id/testbutton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="342dp"
        android:layout_marginBottom="37dp"
        android:text="@string/test"
        app:layout_constraintBottom_toTopOf="@+id/iv_custom_round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.newki.circle_round.RoundCircleImageView
        android:id="@+id/iv_custom_round"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:layout_marginBottom="154dp"
        android:src="@drawable/logo"
        app:isCircle="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/switch1"
        app:round_background_color="#cccccc"
        app:round_background_drawable="@drawable/shape_blue"
        app:round_radius="20dp" />

    <Switch
        android:id="@+id/switch1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="280dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="120dp"
        android:text="SettingsTest"
        app:layout_constraintBottom_toTopOf="@+id/iv_custom_round"
        app:layout_constraintEnd_toEndOf="@+id/testbutton1"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>